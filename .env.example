# Copia este archivo como .env.local y llena los valores.
# Son los MISMOS URL y anon key que usan las apps de los negocios
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# SOLO para las funciones de /api (crear dueños, restablecer contraseñas).
# Sin prefijo VITE_ a propósito: así Vite nunca la mete en el JavaScript del
# navegador. En Vercel va en Settings → Environment Variables.
# NUNCA la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
